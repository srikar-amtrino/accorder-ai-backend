API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS — comma-separated origins, or "*" to allow all (dev only).
# Production: list the Word add-in's SourceLocation host and any other allowed frontends.
CORS_ALLOW_ORIGINS=*

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

AWS_REGION=us-west-1
BEDROCK_MODEL_ID=your_bedrock_model_id_or_inference_profile_arn_here

# AWS credentials for Bedrock.
# Local dev: set these to a permanent IAM user's access key + secret.
# On EC2/ECS: leave them blank and let the instance/task IAM role provide credentials.
# (Bedrock needs the bedrock:InvokeModelWithResponseStream permission.)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

SESSION_TTL_MINUTES=120
SESSION_CLEANUP_INTERVAL_MINUTES=10.0
